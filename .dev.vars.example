API_TOKEN=dev-local-token-change-me
# Prefer managing receivers via /v1/admin/subscribers.
# PUSH_TARGET_URL is only a fallback when the subscribers table is empty.
# PUSH_TARGET_URL=
# PUSH_SECRET=   # applied to the agent subscriber row when it has no secret
LIVE_PUSH_ENABLED=false
BACKFILL_DAYS=60
BACKFILL_SOURCE=graphql
POLL_INTERVAL_SEC=10
TIMEZONE=Asia/Hong_Kong
HORSE_REFRESH_BATCH=5
SUBREQUEST_BUDGET=45
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_429_THRESHOLD=3
# PUSH_RATE_PER_SUB_PER_SEC=2
# PUSH_BACKLOG_COALESCE_MIN=2
# PUSH_BACKLOG_MAX_CHANGES=200
